---
import "@fontsource-variable/bricolage-grotesque/wght.css";
import "@fontsource-variable/instrument-sans/wght.css";
import "lenis/dist/lenis.css";
import "../styles/page.css";
import {
  site,
  links,
  waHref,
  tickerWords,
  specimen,
  statusLine,
} from "../data/links";

/**
 * An index of projects, opened from a TikTok bio.
 *
 * Design rule: there is not a single control. Every motion is a function of
 * scroll position and touch, so there is no state to store and nothing to reset.
 *
 * Copy rule: every sentence must stay true when the second project arrives. The
 * page may describe itself as a collection; it may not describe one product,
 * and it may not sell a service.
 *
 * Content is plain HTML. What motion.ts adds wraps it, it does not create it,
 * so the page stays complete with JavaScript off.
 */
const title = `${site.name} — project yang bisa dicoba`;
const description =
  "Kumpulan project yang bisa dibuka dan dicoba langsung, tanpa mendaftar. Dikerjakan sendiri oleh xyenrae.";
const Arrow = "M7 17 17 7M9 7h8v8";
---

<!doctype html>
<html lang="id" class="motion-pending">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08090A" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="canonical" href={site.url} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={site.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${site.url}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      // Runs before first paint. Two independent decisions:
      // 1. `motion` means "this browser can animate". It gates every animated
      //    state, so a browser that never runs this gets the complete static
      //    page instead of a half-armed one.
      // 2. `booted` means "the intro has already been shown". These must be
      //    separate classes: a repeat visit still animates, it only skips the
      //    intro. Tying both to one class silently disabled all motion on the
      //    second visit.
      const root = document.documentElement;
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      let seen = false;
      try {
        seen = sessionStorage.getItem("xyenrae:boot") === "1";
      } catch {
        // Private mode can throw; treating it as unseen is the safe default.
      }
      root.classList.remove("motion-pending");
      if (reduced) root.classList.add("booted");
      else {
        root.classList.add("motion");
        if (seen) root.classList.add("booted");
      }
    </script>
  </head>

  <body>
    <div class="boot" aria-hidden="true">
      <div class="boot__panel boot__panel--top"></div>
      <div class="boot__panel boot__panel--bottom"></div>
      <div class="boot__inner">
        <span class="boot__mark">{site.name}</span>
        <span class="boot__count" data-boot-count>0</span>
      </div>
    </div>

    <header class="identity">
      <button class="identity__name" type="button" data-egg aria-label="xyenrae">
        {site.name}
      </button>
      <span class="identity__meta">
        <span class="dot" aria-hidden="true"></span>
        {links.length} project
      </span>
    </header>

    <main>
      <section class="hero" data-hero>
        <div class="hero__light hero__light--a" aria-hidden="true"></div>
        <div class="hero__light hero__light--b" aria-hidden="true"></div>
        <canvas class="hero__canvas" data-dust aria-hidden="true"></canvas>

        <h1 class="masthead" data-masthead aria-label="Project yang bisa dicoba.">
          <span>Project yang</span>
          <span>bisa dicoba.</span>
        </h1>

        <p class="lede">
          Situs dan panel admin yang <strong>aku kerjakan sendiri</strong>. Buka
          salah satu, langsung jalan tanpa daftar.
        </p>

        <p class="status">
          <span class="dot" aria-hidden="true"></span>
          {statusLine}
        </p>
      </section>

      <div class="ticker" aria-hidden="true">
        <div class="ticker__track" data-ticker>
          {[...tickerWords, ...tickerWords].map((word) => (
            <span class="ticker__item">
              {word}
              <span class="ticker__sep"> ·</span>
            </span>
          ))}
        </div>
      </div>

      <section aria-labelledby="g-project">
        <div class="group-head">
          <h2 class="eyebrow" id="g-project">project</h2>
          <span class="group-head__count">
            {String(links.length).padStart(2, "0")}
          </span>
        </div>
        <ul class="rows">
          {links.map((item, i) => (
            <li class="row">
              <a class="row__link press" href={item.href} rel="noopener" data-magnet>
                <span class="row__num">{String(i + 1).padStart(2, "0")}</span>
                <span class="row__text">
                  <span class="row__label">
                    {item.live && <span class="dot" aria-hidden="true" />}
                    {item.name}
                  </span>
                  <span class="row__hint">{item.hint}</span>
                  <span class="row__meta">{item.meta}</span>
                </span>
                <svg
                  class="row__mark"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={Arrow} />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="specimen" data-specimen aria-label="Semua bisa kamu coba">
        {specimen.map((word) => <span class="specimen__word">{word}</span>)}
        <span class="specimen__caption">digulir, bukan diatur</span>
      </section>

      <section aria-labelledby="g-kontak">
        <div class="group-head">
          <h2 class="eyebrow" id="g-kontak">kontak</h2>
        </div>
        <ul class="rows">
          <li class="row">
            <a class="row__link press" href={waHref} rel="noopener" data-magnet>
              <span class="row__text">
                <span class="row__label">WhatsApp</span>
                <span class="row__hint">Kalau ada yang mau ditanyakan soal project.</span>
                <span class="row__meta">{site.whatsappLabel}</span>
              </span>
              <svg
                class="row__mark"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={Arrow} />
              </svg>
            </a>
          </li>
        </ul>
      </section>

      <section class="outro" data-outro aria-labelledby="g-outro">
        <h2 class="outro__title" id="g-outro">Project berikutnya menyusul.</h2>
        <p class="outro__sub">
          Halaman ini bertambah tiap ada yang selesai.
        </p>
      </section>
    </main>

    <footer class="foot">
      <span class="foot__host">links.xyenrae.dev</span>
      <span>{new Date().getFullYear()} · dikerjakan sendiri</span>
    </footer>

    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>
